# Python
__pycache__/
*.pyc

# 运行产物（数据库 / 任务工作目录 / 报告输出）
data/
logs/

# 虚拟环境（Linux 部署文档建议 venv，见 docs/usage.md）
.venv/
venv/

# 第三方凭据（FOFA/Shodan 等，绝不入库）
config/settings.json
config/keys.yaml

# 用户自建内容
config/pocs-user/
config/nuclei-templates/

# 外部工具落点（dirmap 是第三方项目，本机用目录联接挂到这里，不随仓库分发）
tools/dirmap/

# 会话/记忆目录（AI 工作笔记，不进仓库）
.workbuddy-ai/
# 另一个 IDE（Trae）的工程目录：里面是各会话的设计稿，随工具走、不属于本项目代码。
# 需要留档的内容请**抄进 docs/** 再忽略（续 9 的三条"刻意不做"已抄进 docs/roadmap.md）。
.trae/

# 本地 GitHub 令牌（用户放置于项目根，含 PAT，**绝不入库**；推送时由 AI 读取走一次性认证头）
github.txt
